<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/spinner_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/dialogTitleDoctor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invite Doctor"
            android:textColor="@color/colorMedicalBlue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogSubtitleDoctor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Create doctor login credentials and assign to hospital."
            android:textColor="@color/colorTextDarkSecondary"
            android:textSize="12sp" />

        <!-- DOCTOR ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Doctor ID"
            app:boxStrokeColor="@color/colorMedicalBlue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDoctorRegId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Doctor ID"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- DOCTOR NAME -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Doctor Name"
            app:boxStrokeColor="@color/colorMedicalBlue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDoctorFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Doctor Name"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords|textNoSuggestions"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- HOSPITAL SELECTION (FOR SUPER ADMIN) / DISPLAY (FOR HOSPITAL ADMIN) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Hospital"
            android:textColor="@color/colorTextDarkSecondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Read-only Hospital Card (Hospital Admin) -->
        <LinearLayout
            android:id="@+id/layoutHospitalReadOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#F1F5F9"
            android:padding="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textAssignedHospital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MediLinkChain Central Network"
                android:textColor="@color/colorTextDark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spinner for Super Admin -->
        <RelativeLayout
            android:id="@+id/layoutHospitalSpinnerContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <Spinner
                android:id="@+id/spinnerHospitalSelect"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:spinnerMode="dropdown" />
        </RelativeLayout>

        <!-- SPECIALIZATION -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Specialization"
            app:boxStrokeColor="@color/colorMedicalBlue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputSpecialization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Specialization"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:inputType="textCapWords|textNoSuggestions"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- PASSWORD -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Create Password"
            app:endIconMode="password_toggle"
            app:boxStrokeColor="@color/colorMedicalBlue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDoctorPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Create Password"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:inputType="textPassword|textNoSuggestions"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONFIRM PASSWORD -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Confirm Password"
            app:endIconMode="password_toggle"
            app:boxStrokeColor="@color/colorMedicalBlue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDoctorConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm Password"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:inputType="textPassword|textNoSuggestions"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelCreateDoctor"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cancel"
                android:textColor="@color/colorTextDarkSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmCreateDoctor"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/colorMedicalBlue"
                android:text="INVITE DOCTOR"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
