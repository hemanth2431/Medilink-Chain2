<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorLightGrayBg"
    android:gravity="center"
    android:padding="24dp"
    android:fitsSystemWindows="true">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorCardOutline">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- ICON BADGE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusIconBgCard"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="36dp"
                app:cardBackgroundColor="#FEF3C7"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/textStatusEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⏳"
                    android:textSize="32sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- STATUS TITLE -->
            <TextView
                android:id="@+id/textVerificationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Verification Under Review"
                android:textColor="@color/colorTextDark"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <!-- STATUS DESCRIPTION -->
            <TextView
                android:id="@+id/textVerificationMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Your medical credentials and registration details are currently undergoing verification by the organization administration. You will gain full Doctor Portal access once approved."
                android:textColor="@color/colorTextDarkSecondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <!-- SUBMITTED DETAILS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#F8FAFC"
                android:padding="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Doctor Reg ID:"
                        android:textColor="@color/colorTextDarkMuted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textDocStatusRegId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DR-MDL-2026-0001"
                        android:textColor="@color/colorMedicalBlue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hospital:"
                        android:textColor="@color/colorTextDarkMuted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textDocStatusHospital"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apollo Hospital"
                        android:textColor="@color/colorTextDark"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- REJECTION REASON BOX (VISIBLE IF REJECTED) -->
                <LinearLayout
                    android:id="@+id/layoutDoctorRejectionBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#FEE2E2"
                    android:padding="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rejection Reason:"
                        android:textColor="#DC2626"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textDocStatusRejectionReason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Doctor registration details could not be verified."
                        android:textColor="#991B1B"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ACTION BUTTONS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckStatus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="CHECK VERIFICATION STATUS"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/colorMedicalBlue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignOutStatus"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sign Out"
                android:textColor="@color/colorTextDarkSecondary"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
