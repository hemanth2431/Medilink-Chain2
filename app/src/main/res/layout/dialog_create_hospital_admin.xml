<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/spinner_background">

        <!-- TITLE & SUBTITLE -->
        <TextView
            android:id="@+id/dialogTitleCreateAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Hospital Admin"
            android:textColor="@color/colorMedicalBlue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogSubtitleCreateAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Provision credentials and assign administrator to an organization."
            android:textColor="@color/colorTextDarkSecondary"
            android:textSize="12sp" />

        <!-- HOSPITAL SELECTION SPINNER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Assigned Hospital *"
            android:textColor="@color/colorTextDark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorMedicalBlue"
            app:cardBackgroundColor="@color/white">

            <Spinner
                android:id="@+id/spinnerCreateAdminHospital"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ADMIN ID ROW (WITH REGENERATE BUTTON) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Admin ID (e.g. AD26H001) *"
                app:boxStrokeColor="@color/colorMedicalBlue"
                app:helperText="Unique Admin ID used for authentication"
                app:helperTextEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputCreateAdminId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegenerateAdminId"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                app:strokeColor="@color/colorMedicalBlue"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/colorMedicalBlue" />

        </LinearLayout>

        <!-- FULL NAME -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Administrator Full Name *"
            app:boxStrokeColor="@color/colorMedicalBlue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCreateAdminName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- EMAIL ADDRESS -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Admin Email Address *"
            app:boxStrokeColor="@color/colorMedicalBlue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCreateAdminEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:inputType="textEmailAddress|textNoSuggestions"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONTACT NUMBER -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Contact Number (Optional)"
            app:boxStrokeColor="@color/colorMedicalBlue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCreateAdminPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:inputType="phone"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- PASSWORD -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Initial Password (min 6 chars) *"
            app:endIconMode="password_toggle"
            app:boxStrokeColor="@color/colorMedicalBlue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCreateAdminPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:inputType="textPassword|textNoSuggestions"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONFIRM PASSWORD -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Confirm Password *"
            app:endIconMode="password_toggle"
            app:boxStrokeColor="@color/colorMedicalBlue"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCreateAdminConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:inputType="textPassword|textNoSuggestions"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- PROGRESS BAR -->
        <ProgressBar
            android:id="@+id/progressBarCreateAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>

