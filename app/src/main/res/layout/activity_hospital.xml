<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Header with Gradient -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_hospitals"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:paddingTop="36dp">

                    <!-- Top Bar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/backArrow"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="Nearby Hospitals"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/refreshBtn"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp"
                            android:src="@drawable/ic_history"
                            app:tint="#FFFFFF" />
                    </RelativeLayout>

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find Medical Help Near You"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLocationStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="Live GPS &amp; OpenStreetMap discovery"
                        android:textColor="#E0E7FF"
                        android:textSize="13sp" />

                    <!-- Search Bar -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="4dp"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <ImageView
                                android:id="@+id/imgSearchIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_search"
                                app:tint="#8E24AA" />

                            <EditText
                                android:id="@+id/searchHospitalInput"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_toEndOf="@id/imgSearchIcon"
                                android:background="@null"
                                android:hint="Search hospitals, clinics..."
                                android:textSize="14sp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:textColor="#1E293B"
                                android:textColorHint="#94A3B8"
                                android:inputType="text"
                                android:singleLine="true"
                                android:imeOptions="actionSearch" />

                            <ImageView
                                android:id="@+id/btnClearSearch"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:padding="4dp"
                                android:src="@drawable/ic_close"
                                app:tint="#94A3B8"
                                android:visibility="gone" />

                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location Permission / GPS State Banner (Dynamic) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermissionBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FCD34D"
                app:cardBackgroundColor="#FEFCE8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/imgBannerIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_alert_custom"
                        app:tint="#D97706" />

                    <TextView
                        android:id="@+id/tvBannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Location Permission Required"
                        android:textColor="#92400E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBannerMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Location permission is required to find hospitals near you."
                        android:textColor="#B45309"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBannerAction"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:text="Allow Location"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="20dp"
                        app:backgroundTint="#D97706"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- OpenStreetMap Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapContainer"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- OpenStreetMap MapView -->
                    <org.osmdroid.views.MapView
                        android:id="@+id/osmMapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Map Overlay Badge (Attribution & Status) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_distance_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvMapBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="© OpenStreetMap"
                            android:textColor="#1D4ED8"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Re-Center User Location FAB -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabMyLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="12dp"
                        app:fabCustomSize="42dp"
                        app:maxImageSize="22dp"
                        app:elevation="4dp"
                        app:backgroundTint="#FFFFFF"
                        app:tint="#1E293B"
                        android:src="@drawable/ic_my_location"
                        android:contentDescription="Center on My Location" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Facilities"
                        android:textColor="#FFFFFF"
                        app:chipBackgroundColor="#8E24AA"
                        app:chipStrokeWidth="0dp"
                        android:checkable="true"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHospitals"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hospitals"
                        android:textColor="#8E24AA"
                        app:chipBackgroundColor="#F3E5F5"
                        app:chipStrokeColor="#8E24AA"
                        app:chipStrokeWidth="1dp"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipClinics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clinics"
                        android:textColor="#8E24AA"
                        app:chipBackgroundColor="#F3E5F5"
                        app:chipStrokeColor="#8E24AA"
                        app:chipStrokeWidth="1dp"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEmergency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency Care"
                        android:textColor="#8E24AA"
                        app:chipBackgroundColor="#F3E5F5"
                        app:chipStrokeColor="#8E24AA"
                        app:chipStrokeWidth="1dp"
                        android:checkable="true" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Loading Indicator View (Non-blocking) -->
            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#8E24AA" />

                <TextView
                    android:id="@+id/tvLoadingMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Finding nearby hospitals..."
                    android:textColor="#8E24AA"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Section Header -->
            <RelativeLayout
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Hospitals Near You"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hospitalCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Discovering..."
                    android:textColor="#8E24AA"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Empty / Error View -->
            <LinearLayout
                android:id="@+id/layoutEmptyError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgEmptyError"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_hospital"
                    app:tint="#CBD5E1" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Unable to find nearby hospitals"
                    android:textColor="#475569"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Check your location settings and internet connection."
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:text="Retry"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:backgroundTint="#8E24AA"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <!-- Dynamic RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNearbyHospitals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                tools:listitem="@layout/item_nearby_hospital" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>