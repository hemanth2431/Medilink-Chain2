<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/colorMedicalBlue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Add Prescription"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Scrollable Form Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Form Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Prescription Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prescription Title *"
                            android:textColor="@color/colorTextDark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/colorMedicalBlue"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/prescriptionTitleInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. Cardiology Consultation"
                                android:inputType="textCapWords"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Doctor Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Doctor Name *"
                            android:textColor="@color/colorTextDark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/colorMedicalBlue"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/doctorNameInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. Dr. Rahul Kumar"
                                android:inputType="textCapWords"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Hospital / Clinic Name (Manual input, no auto suggestions) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hospital / Clinic Name *"
                            android:textColor="@color/colorTextDark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/colorMedicalBlue"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/hospitalNameInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. Apollo Hospital"
                                android:inputType="textCapWords"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Prescription Date -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prescription Date *"
                            android:textColor="@color/colorTextDark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/colorMedicalBlue"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/prescriptionDateInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Select Date"
                                android:focusable="false"
                                android:clickable="true"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- File Picker Section -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prescription File (PDF, JPG, JPEG, PNG) *"
                            android:textColor="@color/colorTextDark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <!-- Add File Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectFile"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="Select Prescription File"
                            android:textSize="14sp"
                            app:cornerRadius="12dp"
                            app:strokeWidth="1.5dp"
                            app:strokeColor="@color/colorMedicalBlue"
                            app:icon="@drawable/ic_cloud_upload"
                            app:iconTint="@color/colorMedicalBlue"
                            app:backgroundTint="#F0F9FF"
                            android:textColor="@color/colorMedicalBlue"
                            android:layout_marginBottom="12dp" />

                        <!-- Selected File Preview Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/selectedFileCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/colorMedicalBlue"
                            app:cardBackgroundColor="#F8FAFC"
                            android:visibility="gone">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/fileIconBadge"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:background="@drawable/bg_pill_time"
                                    android:gravity="center"
                                    android:text="PDF"
                                    android:textColor="@color/colorMedicalBlue"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toEndOf="@id/fileIconBadge"
                                    android:layout_toStartOf="@id/removeFileBtn"
                                    android:layout_marginStart="12dp"
                                    android:layout_centerVertical="true"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/selectedFileNameText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="prescription_doc.pdf"
                                        android:textColor="@color/colorTextDark"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:ellipsize="middle"
                                        android:singleLine="true" />

                                    <TextView
                                        android:id="@+id/selectedFileSizeText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="PDF • 1.2 MB"
                                        android:textColor="@color/colorTextDarkMuted"
                                        android:textSize="11sp" />

                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/removeFileBtn"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:padding="6dp"
                                    android:src="@drawable/ic_close"
                                    app:tint="#EF4444" />

                            </RelativeLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Notes (Optional) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notes (Optional)"
                            android:textColor="@color/colorTextDark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/colorMedicalBlue"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/prescriptionNotesInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. Valid until next checkup"
                                android:inputType="textCapSentences|textMultiLine"
                                android:minLines="2"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Upload Progress Layout -->
                        <LinearLayout
                            android:id="@+id/uploadProgressLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/uploadProgressBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="10dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="@color/colorMedicalBlue" />

                            <TextView
                                android:id="@+id/uploadProgressPercentageText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="6dp"
                                android:text="Uploading prescription... 0%"
                                android:textColor="@color/colorMedicalBlue"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Upload Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUploadPrescription"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:text="UPLOAD PRESCRIPTION"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"
                            app:backgroundTint="@color/colorPrimary"
                            app:elevation="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
