<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header Navigation Bar (Premium Material 3 style) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/backArrow"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/colorMedicalBlue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Scan Patient QR"
                    android:textColor="@color/colorTextDark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/securityShield"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/colorMedicalBlue" />

            </RelativeLayout>

            <!-- Instruction Card (Blue Medical Card with Premium Illustration) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/colorMedicalBlueLight">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/qrScannerIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_scanner"
                        app:tint="@color/colorMedicalBlue" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/recordsIllustration"
                        android:layout_toEndOf="@+id/qrScannerIcon"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scan Patient QR Code"
                            android:textColor="@color/colorMedicalBlue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Ask the patient to show their MediLinkChain QR code to access their medical records."
                            android:textColor="@color/colorTextDarkSecondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/recordsIllustration"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/colorMedicalBlue" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Scanner Section (Large camera area with custom animated laser frame) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000">

                    <!-- Embedded ZXing Barcode Scanner View -->
                    <com.journeyapps.barcodescanner.DecoratedBarcodeView
                        android:id="@+id/barcodeScannerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Custom Semi-transparent Dark Mask Overlay -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#70000000" />

                    <!-- Scanning Framing Area (Center) -->
                    <FrameLayout
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent">

                        <!-- Beautiful Custom Frame Corners -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent" />

                        <!-- We create clear cut inside a camera view. DecoratedBarcodeView handles framing natively, 
                             so we can overlay a premium custom border around the scanning zone -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="2dp">

                            <!-- Modern Border styling with rounded blue corners -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent" />

                            <!-- Top-Left Corner -->
                            <View
                                android:layout_width="32dp"
                                android:layout_height="6dp"
                                android:layout_gravity="start|top"
                                android:background="@color/colorMedicalBlue" />
                            <View
                                android:layout_width="6dp"
                                android:layout_height="32dp"
                                android:layout_gravity="start|top"
                                android:background="@color/colorMedicalBlue" />

                            <!-- Top-Right Corner -->
                            <View
                                android:layout_width="32dp"
                                android:layout_height="6dp"
                                android:layout_gravity="end|top"
                                android:background="@color/colorMedicalBlue" />
                            <View
                                android:layout_width="6dp"
                                android:layout_height="32dp"
                                android:layout_gravity="end|top"
                                android:background="@color/colorMedicalBlue" />

                            <!-- Bottom-Left Corner -->
                            <View
                                android:layout_width="32dp"
                                android:layout_height="6dp"
                                android:layout_gravity="start|bottom"
                                android:background="@color/colorMedicalBlue" />
                            <View
                                android:layout_width="6dp"
                                android:layout_height="32dp"
                                android:layout_gravity="start|bottom"
                                android:background="@color/colorMedicalBlue" />

                            <!-- Bottom-Right Corner -->
                            <View
                                android:layout_width="32dp"
                                android:layout_height="6dp"
                                android:layout_gravity="end|bottom"
                                android:background="@color/colorMedicalBlue" />
                            <View
                                android:layout_width="6dp"
                                android:layout_height="32dp"
                                android:layout_gravity="end|bottom"
                                android:background="@color/colorMedicalBlue" />

                            <!-- Animated Glowing Blue Laser Line -->
                            <View
                                android:id="@+id/scannerLaser"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_gravity="top"
                                android:background="@color/colorAccentBlue" />

                        </FrameLayout>

                    </FrameLayout>

                    <!-- Instruction Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|bottom"
                        android:layout_marginBottom="24dp"
                        android:text="Align the QR code within the frame"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:shadowColor="#80000000"
                        android:shadowRadius="4.0"
                        android:shadowDx="2"
                        android:shadowDy="2"/>

                    <!-- Floating Flashlight/Torch Toggle Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnToggleFlashlight"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="start|bottom"
                        android:layout_margin="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#CC0A3780">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_info_custom"
                            app:tint="#FFFFFF" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Floating Gallery Import Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnImportGallery"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|bottom"
                        android:layout_margin="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#CC0A3780">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_download"
                            app:tint="#FFFFFF" />
                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Security Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EBF3FC"
                app:cardBackgroundColor="@color/securityBg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/securityTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Secure &amp; Protected"
                            android:textColor="@color/securityText"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Verification Badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_outlined_btn"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Doctor Verified"
                            android:textColor="@color/colorMedicalBlue"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </RelativeLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="All patient data is encrypted and securely stored. Only verified practitioners can access the records after patient QR verification."
                        android:textColor="@color/securityText"
                        android:textSize="12sp"
                        android:alpha="0.85" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- How It Works Section (Beautiful steps layout) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="How It Works"
                android:textColor="@color/colorTextDark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <!-- Step 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_role_patient"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/colorPatientTheme"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scan QR Code"
                            android:textColor="@color/colorTextDark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scan the patient's QR code via camera or gallery"
                            android:textColor="@color/colorTextDarkSecondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_role_patient"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/colorPatientTheme"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verify Patient"
                            android:textColor="@color/colorTextDark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Patient details will be verified instantly over MediLinkChain"
                            android:textColor="@color/colorTextDarkSecondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_role_patient"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/colorPatientTheme"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Access Records"
                            android:textColor="@color/colorTextDark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View patient's medical records after successful verification"
                            android:textColor="@color/colorTextDarkSecondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar (Material 3 styling anchored at bottom) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:menu="@menu/doctor_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/colorMedicalBlue"
        app:itemTextColor="@color/colorTextDarkSecondary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>