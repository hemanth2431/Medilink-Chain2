<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardHospitalRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Icon, Title/Address, Distance Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Hospital Icon Badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/iconCard"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#F3E5F5">
                <ImageView
                    android:id="@+id/imgHospitalIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_hospital"
                    app:tint="#8E24AA" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Name and Type/Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/iconCard"
                android:layout_toStartOf="@+id/tvDistanceBadge"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/tvHospitalName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apollo Hospital"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvHospitalAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Jubilee Hills, Hyderabad"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvFacilityTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Hospital · Emergency Care"
                    android:textColor="#8E24AA"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Distance Badge -->
            <TextView
                android:id="@+id/tvDistanceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/bg_distance_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="2.4 km"
                android:textColor="#1D4ED8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp" />

        <!-- Bottom Action Row: Coordinates/Phone and Directions Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layoutInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/btnDirections"
                android:layout_centerVertical="true"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:id="@+id/layoutPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_phone"
                        app:tint="#8E24AA"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/tvHospitalPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+91-40-2360-7777"
                        android:textColor="#475569"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCoordinates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lat: 17.412, Lon: 78.432"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Directions Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDirections"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Directions"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="19dp"
                app:backgroundTint="#8E24AA"
                app:icon="@drawable/ic_navigation"
                app:iconTint="#FFFFFF"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
