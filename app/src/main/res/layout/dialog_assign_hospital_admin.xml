<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/spinner_background">

    <TextView
        android:id="@+id/dialogTitleAssignAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assign Hospital Admin"
        android:textColor="@color/colorMedicalBlue"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialogSubtitleAssignAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Assign the primary administrator credentials for this hospital."
        android:textColor="@color/colorTextDarkSecondary"
        android:textSize="12sp" />

    <!-- SELECTED HOSPITAL INFO (READ ONLY) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#F1F5F9"
        android:padding="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hospital:"
            android:textColor="@color/colorTextDarkSecondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAssignHospitalName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="MediLinkChain Central Network"
            android:textColor="@color/colorTextDark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Hospital Code:"
            android:textColor="@color/colorTextDarkSecondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAssignHospitalCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="MAIN"
            android:textColor="#4F46E5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ADMIN ID -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Admin ID"
        app:boxStrokeColor="@color/colorMedicalBlue"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputAssignAdminId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Admin ID"
            android:autofillHints=""
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ADMIN NAME -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Admin Name"
        app:boxStrokeColor="@color/colorMedicalBlue"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputAssignAdminName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Admin Name"
            android:autofillHints=""
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords|textNoSuggestions"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- PASSWORD -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Create Password"
        app:endIconMode="password_toggle"
        app:boxStrokeColor="@color/colorMedicalBlue"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputAssignAdminPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Create Password"
            android:autofillHints=""
            android:importantForAutofill="no"
            android:inputType="textPassword|textNoSuggestions"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- CONFIRM PASSWORD -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Confirm Password"
        app:endIconMode="password_toggle"
        app:boxStrokeColor="@color/colorMedicalBlue"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputAssignAdminConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirm Password"
            android:autofillHints=""
            android:importantForAutofill="no"
            android:inputType="textPassword|textNoSuggestions"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
