<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <!-- Top App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/colorTextDark"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Doctor Profile"
            android:textColor="@color/colorTextDark"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Profile Avatar Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardCornerRadius="40dp"
                        app:cardBackgroundColor="#EFF6FF"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="👨‍⚕️"
                            android:textSize="40sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/textProfileDoctorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Dr. Hemanth Reddy"
                        android:textColor="@color/colorTextDark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textProfileDoctorRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="DOCTOR • MEDICAL PRACTITIONER"
                        android:textColor="@color/colorMedicalBlue"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- EDITABLE / READ-ONLY DETAILS -->

            <!-- Doctor ID (Read Only) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doctor ID (Assigned)"
                android:textColor="@color/colorTextDarkSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputProfileDoctorId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field"
                android:enabled="false"
                android:focusable="false"
                android:paddingHorizontal="14dp"
                android:textColor="#4F46E5"
                android:textStyle="bold"
                android:textSize="14sp" />

            <!-- Assigned Hospital (Read Only) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned Hospital (Fixed)"
                android:textColor="@color/colorTextDarkSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputProfileHospital"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field"
                android:enabled="false"
                android:focusable="false"
                android:paddingHorizontal="14dp"
                android:textColor="@color/colorTextDark"
                android:textSize="14sp" />

            <!-- Doctor Full Name (Editable) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doctor Name"
                android:textColor="@color/colorTextDarkSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputProfileFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field"
                android:hint="Doctor Name"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/colorTextDark"
                android:textSize="14sp" />

            <!-- Specialization (Editable) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Specialization"
                android:textColor="@color/colorTextDarkSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputProfileSpecialization"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field"
                android:hint="Specialization"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/colorTextDark"
                android:textSize="14sp" />

            <!-- Phone Number (Editable) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textColor="@color/colorTextDarkSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input_field"
                android:hint="Phone Number"
                android:inputType="phone"
                android:paddingHorizontal="14dp"
                android:textColor="@color/colorTextDark"
                android:textSize="14sp" />

            <!-- SAVE BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/colorMedicalBlue"
                android:text="SAVE PROFILE"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- LOGOUT BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogoutDoctor"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="LOGOUT"
                android:textColor="#DC2626"
                android:textSize="14sp"
                android:textStyle="bold"
                app:strokeColor="#DC2626"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
