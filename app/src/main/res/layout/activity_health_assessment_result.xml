<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/colorMedicalBlue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Assessment Results"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/shareBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_history"
                android:visibility="gone"
                app:tint="@color/colorMedicalBlue" />

        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Overall Health Indicator Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/indicatorCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#2E7D32"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OVERALL HEALTH INDICATOR"
                            android:textColor="#E2E8F0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/indicatorValueText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="LOWER CONCERN"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/indicatorReasonText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="All entered parameters are within standard general reference ranges."
                            android:textColor="#F1F5F9"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 2. BMI & Weight Guidance Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚖️ BMI &amp; Body Weight"
                            android:textColor="@color/colorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/bmiValueText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="24.2"
                                android:textColor="@color/colorMedicalBlue"
                                android:textSize="32sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/bmiCategoryBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_time"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="Normal Weight"
                                    android:textColor="@color/colorMedicalBlue"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/healthyWeightRangeText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Healthy Range: 54 kg – 72 kg (Estimated)"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/weightGuidanceText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="#F8FAFC"
                            android:padding="12dp"
                            android:text="Your current BMI is within the general reference range."
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Daily Calorie Estimation Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 Daily Energy Requirements (Mifflin-St Jeor)"
                            android:textColor="@color/colorPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#F1F5F9"
                                android:padding="12dp"
                                android:layout_marginEnd="6dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Estimated BMR"
                                    android:textColor="#64748B"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/bmrText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="1,650 kcal"
                                    android:textColor="@color/colorTextDark"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#F1F5F9"
                                android:padding="12dp"
                                android:layout_marginStart="6dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Maintenance"
                                    android:textColor="#64748B"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/maintenanceCaloriesText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="2,150 kcal"
                                    android:textColor="@color/colorTextDark"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="#EFF6FF"
                            android:padding="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Goal Guidance Target (Estimated)"
                                android:textColor="#1E40AF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/goalCaloriesText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Approximately 2,150 kcal/day"
                                android:textColor="#1E3A8A"
                                android:textSize="14sp" />
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Clinical Metrics (BP & Sugar) Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🩺 Blood Pressure &amp; Blood Sugar"
                            android:textColor="@color/colorPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Blood Pressure -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Blood Pressure:"
                                android:textColor="#475569"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/bpResultText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="120/80 mmHg"
                                android:textColor="@color/colorTextDark"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/bpCategoryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category: Within Expected Range"
                            android:textColor="#16A34A"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp" />

                        <!-- Blood Sugar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Fasting Blood Sugar:"
                                android:textColor="#475569"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/sugarResultText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="90 mg/dL"
                                android:textColor="@color/colorTextDark"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/sugarCategoryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status: Within Expected Range"
                            android:textColor="#16A34A"
                            android:textSize="12sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Food Guidance Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥗 Food Guidance"
                            android:textColor="@color/colorPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RECOMMENDED FOODS"
                            android:textColor="#16A34A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/recommendedFoodsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="14dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FOODS TO LIMIT"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/foodsToLimitContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 6. Daily Health Plan Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅 Daily Health Plan"
                            android:textColor="@color/colorPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/planBreakfastText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🍳 Breakfast: ..."
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/planLunchText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🥗 Lunch: ..."
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/planSnackText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🍎 Snack: ..."
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/planDinnerText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🍲 Dinner: ..."
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/planHydrationText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💧 Hydration: ..."
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/planActivityText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🏃 Physical Activity: ..."
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/planSleepText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🌙 Sleep: ..."
                            android:textColor="#334155"
                            android:textSize="13sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Save Assessment Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveAssessment"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="16dp"
                    android:text="SAVE ASSESSMENT"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="14dp"
                    app:elevation="4dp" />

                <!-- Mandatory Clinical Disclaimer -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="This health assessment provides general health guidance and is not a medical diagnosis. Consult a healthcare professional for medical advice."
                    android:textAlignment="center"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
