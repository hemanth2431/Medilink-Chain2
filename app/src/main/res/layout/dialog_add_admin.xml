<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/spinner_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Invite Administrator"
        android:textColor="@color/colorMedicalBlue"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="New administrator will receive organization access"
        android:textColor="@color/colorTextDarkSecondary"
        android:textSize="12sp" />

    <!-- FULL NAME -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Full Name"
        app:boxStrokeColor="@color/colorMedicalBlue"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputNewAdminName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- EMAIL -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Admin Email Address"
        app:boxStrokeColor="@color/colorMedicalBlue"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputNewAdminEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- PHONE -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Phone Number"
        app:boxStrokeColor="@color/colorMedicalBlue"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputNewAdminPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- PERMISSIONS SECTION -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Administrator Permissions:"
        android:textColor="@color/colorTextDark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/chkPermDoctor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Doctor Management (View, Approve, Reject)"
        android:textColor="@color/colorTextDark"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/chkPermPatient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Patient Management (View, Enable, Disable)"
        android:textColor="@color/colorTextDark"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/chkPermSystem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="System Monitoring (Live activity telemetry)"
        android:textColor="@color/colorTextDark"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/chkPermAudit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Audit Logs (View administrative audit stream)"
        android:textColor="@color/colorTextDark"
        android:textSize="12sp" />
</LinearLayout>
