<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorLightGrayBg">

    <!-- ═══════════════════════════════════════════════════════════
         SCROLLABLE CONTENT
    ═══════════════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutContentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <!-- ─── 1. TOP HERO SECTION ─────────────────────────────── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@drawable/bg_hero_gradient">

                <!-- Subtle Medical Hexagons & Plus Overlay -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.85"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_hero_medical_overlay" />

                <!-- Centered Hero Branding -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginBottom="28dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp">

                    <!-- MediLinkChain Logo -->
                    <ImageView
                        android:id="@+id/logo_shield"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:contentDescription="MediLinkChain Logo"
                        android:src="@drawable/ic_medilink_chain_brand" />

                    <!-- App Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:letterSpacing="0.01"
                        android:text="MediLink Chain"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <!-- Tagline -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:letterSpacing="0.04"
                        android:text="Secure • Connected • Trusted"
                        android:textColor="#BAE6FD"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:alpha="0.95"
                        android:text="Your health data, in your control"
                        android:textColor="#E0F2FE"
                        android:textSize="12sp" />
                </LinearLayout>

            </RelativeLayout>

            <!-- ─── 2. WHITE AUTHENTICATION CARD ────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-40dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/layoutCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="22dp">

                    <!-- Tab Switcher (SIGN IN / REGISTER) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- SIGN IN Tab -->
                        <LinearLayout
                            android:id="@+id/tabSignIn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingBottom="8dp">

                            <TextView
                                android:id="@+id/tabSignInText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.06"
                                android:text="SIGN IN"
                                android:textColor="@color/colorAccentBlue"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/tabSignInIndicator"
                                android:layout_width="56dp"
                                android:layout_height="3dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/tab_indicator_blue" />
                        </LinearLayout>

                        <!-- REGISTER Tab -->
                        <LinearLayout
                            android:id="@+id/tabRegister"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingBottom="8dp">

                            <TextView
                                android:id="@+id/tabRegisterText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.06"
                                android:text="REGISTER"
                                android:textColor="@color/colorTextDarkMuted"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/tabRegisterIndicator"
                                android:layout_width="56dp"
                                android:layout_height="3dp"
                                android:layout_marginTop="8dp"
                                android:background="@android:color/transparent" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Separator -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="20dp"
                        android:background="#F1F5F9" />

                    <!-- ═══════════════════════════════════════════════════
                         FORM 1: SIGN IN STATE
                    ════════════════════════════════════════════════════ -->
                    <LinearLayout
                        android:id="@+id/layoutSignInForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <!-- Email / Admin ID -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Email / Admin ID"
                            android:textColor="@color/colorTextDarkSecondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_input_field_selector"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:id="@+id/icon_email"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_centerVertical="true"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_mail_custom"
                                app:tint="@color/colorTextDarkSecondary" />

                            <EditText
                                android:id="@+id/emailEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@id/icon_email"
                                android:autofillHints=""
                                android:background="@null"
                                android:hint="Enter Email or Admin ID"
                                android:imeOptions="actionNext"
                                android:importantForAutofill="no"
                                android:inputType="text|textNoSuggestions"
                                android:maxLines="1"
                                android:textColor="@color/colorTextDark"
                                android:textColorHint="@color/colorTextDarkMuted"
                                android:textSize="14sp" />
                        </RelativeLayout>

                        <!-- Password -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Password"
                            android:textColor="@color/colorTextDarkSecondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input_field_selector"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:id="@+id/icon_lock"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_centerVertical="true"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_lock_custom"
                                app:tint="@color/colorTextDarkSecondary" />

                            <EditText
                                android:id="@+id/passwordEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp"
                                android:layout_toStartOf="@id/btn_toggle_password"
                                android:layout_toEndOf="@id/icon_lock"
                                android:autofillHints=""
                                android:background="@null"
                                android:hint="Password"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:textColor="@color/colorTextDark"
                                android:textColorHint="@color/colorTextDarkMuted"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/btn_toggle_password"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Toggle Password Visibility"
                                android:padding="4dp"
                                android:src="@drawable/ic_eye_off"
                                app:tint="@color/colorTextDarkMuted" />
                        </RelativeLayout>

                        <!-- Forgot Password -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="18dp">

                            <TextView
                                android:id="@+id/text_forgot_password"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:paddingVertical="4dp"
                                android:paddingStart="6dp"
                                android:text="Forgot password?"
                                android:textColor="@color/colorAccentBlue"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Sign In Button -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/loginBtn"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_btn_signin_gradient"
                            android:stateListAnimator="@null"
                            android:text="Sign In"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Security Message (Inside Card) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_security_shield"
                                app:tint="@color/colorTextDarkMuted" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Protected by end-to-end encrypted sign-in"
                                android:textColor="@color/colorTextDarkMuted"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- ═══════════════════════════════════════════════════
                         FORM 2: REGISTER STATE
                    ════════════════════════════════════════════════════ -->
                    <LinearLayout
                        android:id="@+id/layoutRegisterForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Email Address -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Email Address"
                            android:textColor="@color/colorTextDarkSecondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_input_field_selector"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:id="@+id/icon_reg_email"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_centerVertical="true"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_mail_custom"
                                app:tint="@color/colorTextDarkSecondary" />

                            <EditText
                                android:id="@+id/registerEmailEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@id/icon_reg_email"
                                android:autofillHints=""
                                android:background="@null"
                                android:hint="Enter Email Address"
                                android:imeOptions="actionNext"
                                android:importantForAutofill="no"
                                android:inputType="textEmailAddress|textNoSuggestions"
                                android:maxLines="1"
                                android:textColor="@color/colorTextDark"
                                android:textColorHint="@color/colorTextDarkMuted"
                                android:textSize="14sp" />
                        </RelativeLayout>

                        <!-- Password -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Password"
                            android:textColor="@color/colorTextDarkSecondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_input_field_selector"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:id="@+id/icon_reg_lock"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_centerVertical="true"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_lock_custom"
                                app:tint="@color/colorTextDarkSecondary" />

                            <EditText
                                android:id="@+id/registerPasswordEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp"
                                android:layout_toStartOf="@id/btn_toggle_reg_password"
                                android:layout_toEndOf="@id/icon_reg_lock"
                                android:autofillHints=""
                                android:background="@null"
                                android:hint="Enter Password"
                                android:imeOptions="actionNext"
                                android:importantForAutofill="no"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:textColor="@color/colorTextDark"
                                android:textColorHint="@color/colorTextDarkMuted"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/btn_toggle_reg_password"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Toggle Password Visibility"
                                android:padding="4dp"
                                android:src="@drawable/ic_eye_off"
                                app:tint="@color/colorTextDarkMuted" />
                        </RelativeLayout>

                        <!-- Confirm Password -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Confirm Password"
                            android:textColor="@color/colorTextDarkSecondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginBottom="22dp"
                            android:background="@drawable/bg_input_field_selector"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:id="@+id/icon_reg_lock_confirm"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_centerVertical="true"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_lock_custom"
                                app:tint="@color/colorTextDarkSecondary" />

                            <EditText
                                android:id="@+id/registerConfirmPasswordEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp"
                                android:layout_toStartOf="@id/btn_toggle_reg_confirm_password"
                                android:layout_toEndOf="@id/icon_reg_lock_confirm"
                                android:autofillHints=""
                                android:background="@null"
                                android:hint="Confirm Password"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:textColor="@color/colorTextDark"
                                android:textColorHint="@color/colorTextDarkMuted"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/btn_toggle_reg_confirm_password"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Toggle Confirm Password Visibility"
                                android:padding="4dp"
                                android:src="@drawable/ic_eye_off"
                                app:tint="@color/colorTextDarkMuted" />
                        </RelativeLayout>

                        <!-- Create Account Button -->
                        <RelativeLayout
                            android:id="@+id/btnCreateAccount"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_btn_signin_gradient"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/textRegisterBtn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="Create Account"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_arrow_right_bold" />
                        </RelativeLayout>

                        <!-- Encryption Notice -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_lock_custom"
                                app:tint="@color/colorTextDarkMuted" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Your data is encrypted and secure with MediLink Chain"
                                android:textColor="@color/colorTextDarkMuted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Already have an account? Sign In -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Already have an account? "
                                android:textColor="@color/colorTextDarkSecondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textSwitchToSignIn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:padding="4dp"
                                android:text="Sign In"
                                android:textColor="@color/colorAccentBlue"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ─── 10. BOTTOM MESSAGE (BELOW CARD) ─────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_security_shield"
                    app:tint="@color/colorAccentBlue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="MediLink Chain keeps your data safe and private"
                    android:textColor="@color/colorTextDarkSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- ═══════════════════════════════════════════════════════════
         LOADING OVERLAY
    ═══════════════════════════════════════════════════════════ -->
    <RelativeLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#70000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingVertical="24dp">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminateTint="@color/colorAccentBlue" />

                <TextView
                    android:id="@+id/textLoadingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Authenticating..."
                    android:textColor="@color/colorTextDark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textLoadingSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Securing session &amp; resolving portal"
                    android:textColor="@color/colorTextDarkSecondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

</RelativeLayout>