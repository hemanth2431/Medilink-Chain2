<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:baselineAligned="false">

    <!-- Timeline Indicator Left Column -->
    <RelativeLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal">

        <!-- Vertical Timeline Line -->
        <View
            android:id="@+id/timelineLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:background="#D1E4F6" />

        <!-- Timeline Dot Indicator -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp"
            app:strokeWidth="2dp"
            app:strokeColor="#FFFFFF"
            app:cardBackgroundColor="@color/colorPrimary" />

    </RelativeLayout>

    <!-- Right Side: Medical Record Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginVertical="8dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#F0F4F8"
        app:cardBackgroundColor="#FFFFFF">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Title & Info Column -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/navigationChevron"
                android:orientation="vertical">

                <!-- Tags & Badges row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <!-- Category Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#E3F2FD">
                        <TextView
                            android:id="@+id/categoryTagText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Lab Report"
                            android:textColor="@color/colorPrimary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Verified Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/verifiedBadgeCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#E8F5E9">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_shield"
                                android:layout_marginEnd="4dp"
                                app:tint="@color/sosEnd" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Verified"
                                android:textColor="@color/sosEnd"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Record Title -->
                <TextView
                    android:id="@+id/reportTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blood Test Report"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <!-- Hospital / Doctor -->
                <TextView
                    android:id="@+id/reportOriginText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City Care Hospital"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="4dp" />

                <!-- Date -->
                <TextView
                    android:id="@+id/reportDateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20 May 2024"
                    android:textColor="@color/textMuted"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- Arrow Navigation Icon (Chevron Right) -->
            <ImageView
                android:id="@+id/navigationChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/textMuted" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
