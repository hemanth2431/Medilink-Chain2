<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/colorMedicalBlue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Assessment History"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="80dp">

                <!-- Progress Tracking Trends Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/trendsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📈 Progress Tracking Trends"
                            android:textColor="@color/colorPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Trends Available Layout -->
                        <LinearLayout
                            android:id="@+id/trendsLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="#F1F5F9"
                                    android:padding="10dp"
                                    android:layout_marginEnd="4dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Weight Change"
                                        android:textColor="#64748B"
                                        android:textSize="11sp" />
                                    <TextView
                                        android:id="@+id/trendWeightText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="-1.5 kg"
                                        android:textColor="@color/colorTextDark"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="#F1F5F9"
                                    android:padding="10dp"
                                    android:layout_marginStart="4dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="BMI Change"
                                        android:textColor="#64748B"
                                        android:textSize="11sp" />
                                    <TextView
                                        android:id="@+id/trendBmiText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="-0.5"
                                        android:textColor="@color/colorTextDark"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/trendBpText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Blood Pressure Trend: 125/85 → 120/80 mmHg"
                                android:textColor="#334155"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/trendSugarText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Blood Sugar Trend: 98 → 90 mg/dL"
                                android:textColor="#334155"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <!-- Insufficient Data Message -->
                        <TextView
                            android:id="@+id/trendInsufficientText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Not enough data to show a trend. Save at least two assessments to track your progress over time."
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Loading State -->
                <ProgressBar
                    android:id="@+id/historyProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:visibility="gone" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/historyEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/colorTextDarkMuted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="No Assessments Saved"
                        android:textColor="@color/colorTextDark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Complete a health assessment to track your personal health progress."
                        android:textAlignment="center"
                        android:textColor="@color/colorTextDarkSecondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- RecyclerView for Previous Assessments -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/historyRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- FAB: New Assessment -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNewAssessment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="New Assessment"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:icon="@drawable/ic_check_circle"
        app:iconTint="#FFFFFF"
        app:backgroundTint="@color/colorPrimary"
        app:elevation="6dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
